[Desktop Entry]
Actions=capture-action;capture-memo;
Categories=Office;
Comment=Keep memos, actions, curios, and zettels together
Exec=commonplace %u
Icon=accessories-text-editor
Keywords=notes;memo;zettelkasten;
MimeType=x-scheme-handler/commonplace;
Name=Commonplace
StartupNotify=true
Terminal=false
Type=Application

[Desktop Action capture-action]
Exec=commonplace capture action
Name=Capture an Action

[Desktop Action capture-memo]
Exec=commonplace capture memo
Name=Capture a Memo
